{
  "name": "springbreaker",
  "version": "1.0.0",
  "description": "Deterministic MCP server that breaks through Spring Boot dependency vulnerabilities — automated remediation via IQ Server, Nexus, and Maven",
  "type": "module",
  "bin": {
    "springbreaker": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-built.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run smoke",
    "audit": "npm audit --audit-level=moderate",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "spring-boot",
    "maven",
    "sonatype",
    "iq-server",
    "nexus",
    "vulnerability",
    "remediation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askula3/daemon.git",
    "directory": "mcp/springbreaker"
  },
  "bugs": "https://github.com/askula3/daemon/issues",
  "homepage": "https://github.com/askula3/daemon/tree/main/mcp/springbreaker#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^18.0.3",
    "fast-xml-parser": "^5.11.1",
    "p-limit": "^7.3.3",
    "simple-git": "^3.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.8.0"
}
