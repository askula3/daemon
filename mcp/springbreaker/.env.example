# Copy to mcp/springbreaker/.env for trusted server configuration.
# Never commit real credentials. Non-loopback service URLs require HTTPS.

# Sonatype IQ Server (required for vulnerability detection/remediation)
IQ_SERVER_URL=https://iq.example.com
IQ_USERNAME=service-account
IQ_SERVER_TOKEN=replace-with-iq-user-token
IQ_APP_ID=replace-with-public-application-id

# Sonatype Nexus Repository (optional; Maven Central is the public fallback)
NEXUS_URL=https://nexus.example.com
NEXUS_USERNAME=read-only-service-account
NEXUS_PASSWORD=replace-with-nexus-password

# Restrict caller-supplied project paths. Use ':' on Unix and ';' on Windows.
SPRINGBREAKER_ALLOWED_ROOTS=/absolute/path/to/projects

# Maven
PREFER_MVNW=true
# MAVEN_OPTS=-Xmx2g
# Add only names Maven truly needs; service credentials are never inherited.
# MAVEN_ENV_ALLOWLIST=HTTP_PROXY,HTTPS_PROXY,NO_PROXY

# Default project policy
DEFAULT_SEVERITY=HIGH,MEDIUM
ALLOW_MINOR_UPGRADES=true
ALLOW_MAJOR_UPGRADES=false
ALLOW_SNAPSHOTS=false
ALLOW_REDHAT=false

# Trust-boundary escape hatches: keep false in production.
ALLOW_INSECURE_HTTP=false
ALLOW_PROJECT_SERVICE_CONFIG=false

# debug | info | warn | error
LOG_LEVEL=info
